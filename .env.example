# ─────────────────────────────────────────────────────────────────────────
# Lingora environment configuration
# Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────
# Dashboard: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon...
# Server-side only (Edge Functions / Electron main). Never prefixed with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...anon...
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role...
# For the Supabase MCP tooling (optional, dev only)
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_PROJECT_REF=your-project-ref

# ── Google Gemini AI ──────────────────────────────────────────────────────
# aistudio.google.com/app/apikey — used by the renderer for direct Live API.
VITE_GEMINI_API_KEY=AIza...
# Server-side fallback / default (Edge Functions, Electron main).
GEMINI_API_KEY=AIza...
# Default text model and live realtime model (override freely).
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-2.5-flash-exp
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ── Speech-to-Text provider (live conversation) ────────────────────────────
# One of: browser (default, in-browser Web Speech), google, deepgram, assemblyai
STT_PROVIDER=browser
# Provider keys when not using the browser fallback (server-side only)
STT_API_KEY=

# ── Google Drive (optional, course material storage) ───────────────────────
VITE_GOOGLE_CLIENT_ID=...
VITE_GOOGLE_DRIVE_FOLDER_ID=...

# ── App / runtime ──────────────────────────────────────────────────────────
NODE_ENV=development
VITE_APP_ENV=development
# Disable GPU hardware acceleration (set true if rendering crashes on a machine)
DISABLE_GPU=false
# Public web origin (Netlify). Used for OAuth redirects in the web build.
VITE_PUBLIC_ORIGIN=http://localhost:5173

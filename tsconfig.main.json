{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./",
    // Electron main process — Node + Common/Esm interop. `Blob` resolves via
    // @types/node (Node 18+ global). tsc checks only; esbuild/Vite bundles.
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": ["src/main/**/*", "src/shared/**/*"]
}
